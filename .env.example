# Configuracion SMTP para el envio de notificaciones por correo.
# Copie este archivo como .env y complete sus credenciales. NO suba .env al repo.
#
# Ejemplo con Gmail (requiere una "Contrasena de aplicacion", no la clave normal):
#   1. Active verificacion en 2 pasos en su cuenta Google.
#   2. Cree una App Password en https://myaccount.google.com/apppasswords
#   3. Use esa contrasena de 16 caracteres en FOTORRADAR_SMTP_PASSWORD.

FOTORRADAR_SMTP_HOST=smtp.gmail.com
FOTORRADAR_SMTP_PORT=587
FOTORRADAR_SMTP_SECURITY=starttls
FOTORRADAR_SMTP_USER=tu_correo@gmail.com
FOTORRADAR_SMTP_PASSWORD="tu_app_password_de_16_caracteres"
FOTORRADAR_SMTP_FROM=tu_correo@gmail.com
